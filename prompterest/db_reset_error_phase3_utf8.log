prompt\r\ncreate or replace view public.prompt_stats 
as\r\n  select \r\n    p.id as prompt_id,\r\n    
count(distinct r.id) as rating_count,\r\n    
coalesce(avg(r.value), 0) as average_rating,\r\n    
count(distinct c.id) as comment_count\r\n  from 
